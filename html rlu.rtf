\
function renderCtRatioChart(payload)\{\
  let canvas = document.getElementById("ctRatioChart");\
  if(!canvas) return;\
\
  if(ctRatioChart)\{\
    ctRatioChart.destroy();\
  \}\
\
  let meta = document.getElementById("ctRatioMeta");\
  if(meta)\{\
    meta.innerHTML =\
      `
\f2 \'aa\'e8\'c7\'a7\'a2\'e9\'cd\'c1\'d9\'c5
\f0 : $\{payload.range_text || ((payload.start_date || "-") + " 
\f2 \'b6\'d6\'a7
\f0  " + (payload.end_date || "-"))\}\
       | 
\f2 \'cd\'d1\'bb\'e0\'b4\'b5\'c5\'e8\'d2\'ca\'d8\'b4
\f0 : $\{payload.updatedAt || "-"\}\
       | $\{payload.note || ""\}`;\
  \}\
\
  if(!payload.labels || payload.labels.length === 0)\{\
    if(meta)\{\
      meta.innerHTML += "<br>
\f2 \'c2\'d1\'a7\'e4\'c1\'e8\'c1\'d5\'a2\'e9\'cd\'c1\'d9\'c5
\f0  Top Ward C:T Ratio 
\f2 \'a8\'d2\'a1
\f0  S2G";\
    \}\
    return;\
  \}\
\
  ctRatioChart = new Chart(canvas,\{\
    type:"bar",\
    data:\{\
      labels: payload.labels || [],\
      datasets:[\{\
        label:"C:T Ratio",\
        data: payload.ratioValues || [],\
        backgroundColor:"rgba(245, 158, 11, 0.78)",\
        borderColor:"rgba(217, 119, 6, 0.95)",\
        borderWidth:1,\
        borderRadius:10,\
        maxBarThickness:28\
      \}]\
    \},\
    options:\{\
      responsive:true,\
      maintainAspectRatio:false,\
      plugins:\{\
        legend:\{display:false\},\
        tooltip:\{\
          callbacks:\{\
            label:function(ctx)\{\
              return `C:T Ratio: $\{Number(ctx.parsed.y || 0).toFixed(2)\}:1`;\
            \},\
            afterBody:function(items)\{\
              let i = items[0].dataIndex;\
              return [\
                `Crossmatch: $\{(payload.crossmatchValues || [])[i] || 0\} units`,\
                `Transfusion: $\{(payload.transfusionValues || [])[i] || 0\} units`\
              ];\
            \}\
          \}\
        \},\
        datalabels:\{\
          anchor:"end",\
          align:"top",\
          formatter:function(v)\{\
            return Number(v || 0).toFixed(2) + ":1";\
          \}\
        \}\
      \},\
      scales:\{\
        y:\{\
          beginAtZero:true,\
          ticks:\{\
            callback:function(v)\{\
              return Number(v).toFixed(1) + ":1";\
            \}\
          \}\
        \}\
      \}\
    \}\
  \});\
\}\
